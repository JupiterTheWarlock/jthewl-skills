# Cloudflare R2 图床管理 — 环境变量配置
#
# 将此文件复制为 .env 并填入你的 R2 凭证:
#   cp .env.example .env
#
# 也可通过进程环境变量注入（优先级更高）

# 必填 (Required):
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY=your_r2_access_key_id
R2_SECRET_KEY=your_r2_secret_access_key

# 可选 (Optional):
R2_BUCKET=assets                         # Bucket 名称（默认: assets）
R2_ENDPOINT=                             # S3 端点（留空则从 Account ID 自动推导）
R2_PUBLIC_URL=                           # 自定义 CDN 域名（留空使用默认 R2.dev 域名）
